# Public URL only. Never place API keys in VITE_ variables.
# Leave empty to run the explorer in its clearly labeled illustrative mode.
VITE_API_BASE_URL=
# Optional public Formspree endpoint, e.g. https://formspree.io/f/YOUR_FORM_ID.
# Enable CAPTCHA in Formspree before setting this. Never put a recipient email here.
# Leave empty to show LinkedIn contact only.
VITE_CONTACT_FORM_ENDPOINT=
# Local development and jake-costello.com use /.
# GitHub Actions defaults to /Personal-Website/ unless its variable overrides it.
VITE_BASE_PATH=/
