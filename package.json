{
  "name": "jake-costello-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "tsx --test src/game/*.test.ts src/lib/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.json *.ts *.html .github/workflows/*.yml"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
